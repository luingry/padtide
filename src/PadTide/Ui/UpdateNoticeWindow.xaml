<Window x:Class="PadTide.Ui.UpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadTide"
        Width="364"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Margin="22,14,22,30" CornerRadius="22" Background="{StaticResource Brush.Surface}" Effect="{StaticResource Elevation.Panel}">
        <Grid Margin="20,18,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="BrandIcon" Grid.RowSpan="2" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Title}" Text="Atualização disponível" />
            <TextBlock x:Name="DetailText" Grid.Column="1" Grid.Row="1" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />

            <Grid x:Name="ProgressRail" Grid.Row="2" Grid.ColumnSpan="2" Height="8" Margin="0,18,4,8" Visibility="Collapsed">
                <Border CornerRadius="{StaticResource Radius.Rail}" Background="{StaticResource Brush.Track}" />
                <Border x:Name="ProgressFill" CornerRadius="{StaticResource Radius.Rail}" Background="{StaticResource Brush.Accent}" HorizontalAlignment="Left" Width="0" />
            </Grid>

            <StackPanel x:Name="Actions" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource Tide.Button.Text}" Content="Agora não" Margin="0,0,6,0" Click="OnLaterClicked" />
                <Button Style="{StaticResource Tide.Button.Primary}" Content="Atualizar" Click="OnUpdateClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
