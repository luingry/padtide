<Window x:Class="PadTide.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PadTide.Ui"
        Title="PadTide"
        Width="404"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="30,26,30,38">
        <ui:TideSurface x:Name="Tide" CornerRadius="{StaticResource Radius.Panel}" Effect="{StaticResource Elevation.Panel}" />

        <Grid Margin="{StaticResource Space.Panel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,8,0,34">
                <Image x:Name="BrandIcon" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="PadTide" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Version}" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <DockPanel>
                    <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Text.Value}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Opacidade" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </DockPanel>
                <Slider x:Name="OpacitySlider" Style="{StaticResource Tide.Slider}" Minimum="10" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="10"
                        AutomationProperties.Name="Opacidade" ValueChanged="OnOpacityChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <DockPanel>
                    <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Style="{StaticResource Text.Value}" />
                    <TextBlock Style="{StaticResource Text.Label}" Text="Tamanho" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </DockPanel>
                <Slider x:Name="SizeSlider" Style="{StaticResource Tide.Slider}" Minimum="30" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                        AutomationProperties.Name="Tamanho" ValueChanged="OnSizeChanged" />
            </StackPanel>

            <CheckBox x:Name="StartupToggle" Grid.Row="3" Style="{StaticResource Tide.Toggle}" Margin="0,0,0,14"
                      AutomationProperties.Name="Iniciar com o Windows">
                <TextBlock Style="{StaticResource Text.Label}" Text="Iniciar com o Windows" />
            </CheckBox>

            <DockPanel Grid.Row="4" Margin="0,0,-12,26">
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Tide.Button.Text}" Content="Verificar" Click="OnUpdateClicked"
                        AutomationProperties.Name="Verificar atualizações" />
                <TextBlock Style="{StaticResource Text.Label}" Text="Atualizações" VerticalAlignment="Center" />
            </DockPanel>

            <DockPanel Grid.Row="5" Margin="0,0,-12,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Tide.Button.Text}" Content="Encerrar" Click="OnQuitClicked"
                        AutomationProperties.Name="Encerrar o PadTide" />
                <TextBlock x:Name="BatteryText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>

        <Button Style="{StaticResource Tide.Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                Click="OnCloseClicked" AutomationProperties.Name="Fechar" IsCancel="True">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
    </Grid>
</Window>
