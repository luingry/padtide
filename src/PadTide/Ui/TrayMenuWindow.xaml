<Window x:Class="PadTide.Ui.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadTide"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Margin="18,12,18,24" Padding="6" CornerRadius="16" Background="{StaticResource Brush.Surface}" Effect="{StaticResource Elevation.Panel}" MinWidth="176">
        <StackPanel>
            <Button Style="{StaticResource Tide.Button.Menu}" Content="Configurações" Click="OnSettingsClicked" />
            <Button Style="{StaticResource Tide.Button.Menu}" Content="Encerrar" Click="OnQuitClicked" />
        </StackPanel>
    </Border>
</Window>
