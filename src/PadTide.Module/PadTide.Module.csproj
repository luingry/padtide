<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SwissTechKnife module (padtide): a thin supervisor that runs PadTide in its own process (hosted mode).
    The app is packaged next to it by scripts/pack-module.ps1; this assembly only depends on the SDK.
  -->
  <PropertyGroup>
    <RootNamespace>PadTide.Module</RootNamespace>
    <AssemblyName>PadTide.Module</AssemblyName>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only: the host provides the one shared copy at runtime. Refresh from a SwissTechKnife build. -->
    <Reference Include="SwissTechKnife.Sdk" HintPath="lib\SwissTechKnife.Sdk.dll" Private="false" />
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
