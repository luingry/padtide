<UserControl x:Class="PadTide.Module.ModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SwissTechKnife.Sdk;assembly=SwissTechKnife.Sdk">
    <!-- Design-system keys only (SwissTechKnife.Sdk theme, resolved from the host at runtime). -->
    <ScrollViewer Padding="28,8,28,28">
        <Border Style="{StaticResource Card}" Padding="24" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bateria do GameSir Nova 2 Lite" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                    <Border x:Name="StatusChip" Grid.Column="1" Style="{StaticResource Chip}">
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Text.Paragraph}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="O widget aparece sozinho quando o controle está ligado. Opacidade e tamanho ficam nas configurações do PadTide, que também abrem com um duplo clique no widget." />
                <WrapPanel Margin="0,20,0,0">
                    <Button x:Name="OpenButton" Style="{StaticResource Button.Primary}" ui:Ui.Icon="&#xE713;"
                            Content="Abrir PadTide" Margin="0,0,0,8" Click="OpenButton_OnClick" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
